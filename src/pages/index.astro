---
// Argota landing page — standalone (does not use Base.astro layout).
// Preserves the visual identity of the original argota.com static landing
// (Inter + Playfair Display, slate-blue accent #4a9fd6, warm surface).
// Blog routes under /blog/* use a separate Base.astro layout with a
// deeper slate-blue accent (#3a5a8a).

const siteUrl = import.meta.env.SITE_URL || 'https://argota.pages.dev';
const canonical = new URL('/', siteUrl).toString();
const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Argota — Markets, Delivered</title>
  <meta name="description" content="Argota projects brands and markets." />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content="Argota — Markets, Delivered" />
  <meta property="og:description" content="Argota projects brands and markets." />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;600;700&display=swap"
    rel="stylesheet"
  />
  <style is:global>
    :root {
      --bg: #ffffff;
      --surface: #f5f3ef;
      --border: #e0dcd5;
      --text: #2c2c2c;
      --muted: #6b6560;
      --accent: #4a9fd6;
      --accent-hover: #2171a8;
      --white: #fff;
      --heading: #1a1a1a;
      --display: 'Playfair Display', Georgia, serif;
      --body: 'Inter', -apple-system, sans-serif;
      --max-w: 1120px;
    }
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--body);
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--accent); text-decoration: none; transition: color .2s; }
    a:hover { color: var(--accent-hover); }

    .nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      background: rgba(255,255,255,.85);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
    }
    .nav::after {
      content: ''; position: absolute; bottom: -8px; left: 0; right: 0; height: 8px;
      background: linear-gradient(to bottom, rgba(0,0,0,.04), transparent);
      pointer-events: none;
    }
    .nav-inner {
      max-width: var(--max-w); margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
      padding: 1.25rem 2rem;
    }
    .nav-logo {
      font-family: var(--display); font-size: 1.6rem; font-weight: 700;
      color: var(--accent); letter-spacing: .04em;
    }
    .nav-logo:hover { color: var(--accent-hover); }
    .nav-links { display: flex; gap: 2rem; list-style: none; }
    .nav-links a {
      font-size: .85rem; font-weight: 500; letter-spacing: .06em;
      text-transform: uppercase; color: var(--muted);
    }
    .nav-links a:hover { color: var(--heading); }
    .nav-toggle { display: none; background: none; border: none; cursor: pointer; }
    .nav-toggle span {
      display: block; width: 24px; height: 2px;
      background: var(--text); margin: 5px 0; transition: .3s;
    }
    @media (max-width: 768px) {
      .nav-toggle { display: block; }
      .nav-links {
        display: none; flex-direction: column;
        position: absolute; top: 100%; left: 0; right: 0;
        background: rgba(255,255,255,.95);
        backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
        padding: 1.5rem 2rem; gap: 1.25rem;
      }
      .nav-links.open { display: flex; }
    }

    .hero {
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      text-align: center; padding: 8rem 2rem 6rem;
      position: relative; background: var(--surface);
    }
    .hero-content { max-width: 720px; position: relative; z-index: 1; }
    .hero-badge {
      display: inline-block;
      font-size: .75rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase;
      color: var(--accent); border: 1px solid var(--border);
      padding: .4rem 1.2rem; border-radius: 2rem; margin-bottom: 2rem;
    }
    .hero h1 {
      font-family: var(--display);
      font-size: clamp(2.8rem, 6vw, 4.5rem);
      font-weight: 700; line-height: 1.1;
      color: var(--heading); margin-bottom: 1.5rem;
    }
    .hero h1 em { font-style: normal; color: var(--accent); }
    .hero p {
      font-size: 1.15rem; color: var(--muted);
      max-width: 540px; margin: 0 auto 2.5rem;
    }
    .cta {
      display: inline-flex; align-items: center;
      background: var(--accent); color: var(--white);
      font-weight: 600; font-size: .9rem;
      padding: .85rem 2rem; border-radius: 4px;
      transition: background .2s;
    }
    .cta:hover { background: var(--accent-hover); color: var(--white); }

    .section-inner { max-width: var(--max-w); margin: 0 auto; }
    .section-label {
      font-size: .75rem; font-weight: 600; letter-spacing: .2em;
      text-transform: uppercase; color: var(--accent);
      margin-bottom: .75rem;
    }
    .section-title {
      font-family: var(--display);
      font-size: clamp(1.8rem, 4vw, 2.6rem);
      font-weight: 600; color: var(--heading); margin-bottom: 1rem;
    }
    .section-sub { color: var(--muted); max-width: 560px; margin-bottom: 3.5rem; }

    .about { padding: 6rem 2rem; background: var(--bg); }
    .about-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 4rem; align-items: start;
    }
    @media (max-width: 768px) {
      .about-grid { grid-template-columns: 1fr; gap: 2rem; }
    }
    .about-text p { color: var(--muted); margin-bottom: 1.25rem; font-size: .95rem; }

    .contact { padding: 6rem 2rem; background: var(--surface); }
    .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; }
    @media (max-width: 768px) {
      .contact-grid { grid-template-columns: 1fr; gap: 2rem; }
    }
    .contact-info p { color: var(--muted); margin-bottom: 1.5rem; }
    .contact-detail { display: flex; gap: .75rem; margin-bottom: 1.25rem; }
    .contact-detail .icon { color: var(--accent); flex-shrink: 0; }
    .contact-detail span a { color: var(--accent); }
    .form { display: flex; flex-direction: column; gap: 1rem; }
    .form input, .form textarea {
      background: var(--white); border: 1px solid var(--border);
      border-radius: 4px; padding: .85rem 1rem;
      color: var(--text); font-family: var(--body); font-size: .9rem;
      transition: border-color .2s;
    }
    .form input:focus, .form textarea:focus { outline: none; border-color: var(--accent); }
    .form textarea { min-height: 140px; resize: vertical; }
    .form button {
      background: var(--accent); color: var(--white); border: none;
      padding: .85rem 2rem; font-weight: 600; font-size: .9rem;
      border-radius: 4px; cursor: pointer; transition: background .2s;
      align-self: flex-start;
    }
    .form button:hover { background: var(--accent-hover); }

    .partners {
      padding: 2.5rem 2rem; text-align: center;
      background: var(--bg); border-top: 1px solid var(--border);
    }
    .partners p { font-size: .9rem; color: var(--muted); font-style: italic; }
    .partners a { color: var(--accent); font-weight: 500; font-style: normal; }
    .partners a:hover { color: var(--accent-hover); }

    .footer {
      border-top: 1px solid var(--border);
      padding: 2.5rem 2rem; text-align: center;
      background: var(--surface);
    }
    .footer p { font-size: .8rem; color: var(--muted); }
  </style>
</head>
<body>
  <nav class="nav">
    <div class="nav-inner">
      <a href="#" class="nav-logo">Argota</a>
      <button
        class="nav-toggle"
        aria-label="Menu"
        onclick="document.querySelector('.nav-links').classList.toggle('open')"
      >
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-links">
        <li><a href="#about">About</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </div>
  </nav>

  <section class="hero" id="hero">
    <div class="hero-content">
      <div class="hero-badge">Engagement · Projection</div>
      <h1>Markets, <em>delivered</em></h1>
      <p>Argota projection services.</p>
      <a href="#contact" class="cta">Start a conversation</a>
    </div>
  </section>

  <section class="about" id="about">
    <div class="section-inner">
      <div class="about-grid">
        <div>
          <div class="section-label">About</div>
          <h2 class="section-title">Argota Design</h2>
        </div>
        <div class="about-text">
          <p>Argota bridges design and culture. We project brands into markets — by shaping a first encounter into a memory.</p>
          <p>Every market has its own rhythms. Argota works inside that fluency — building the arch between intent and presence in the places that matter.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="section-inner">
      <div class="contact-grid">
        <div class="contact-info">
          <div class="section-label">Contact</div>
          <h2 class="section-title">Let's talk</h2>
          <p>We'd like to hear what you're working on.</p>
        </div>
        <form class="form" onsubmit="return false;">
          <input type="text" placeholder="Name" required />
          <input type="email" placeholder="Email" required />
          <input type="text" placeholder="Subject" />
          <textarea placeholder="Tell us about your project or inquiry"></textarea>
          <button type="submit">Send message</button>
        </form>
      </div>
    </div>
  </section>

  <div class="partners">
    <p>Now joined by our partners at <a href="https://choralieu.com">Choralieu</a></p>
  </div>

  <footer class="footer">
    <p>&copy; {year} Argota. All rights reserved.</p>
  </footer>
</body>
</html>
